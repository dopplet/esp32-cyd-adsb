#pragma once

// WiFi credentials
#define WIFI_SSID "your_wifi_ssid"
#define WIFI_PASS "your_wifi_password"

// Home location (latitude, longitude)
#define HOME_LAT 38.897957
#define HOME_LON -77.036560


// ADS-B settings — reduced for CYD (no PSRAM, 320KB DRAM)
#define ADSB_RADIUS_NM 20
#define ADSB_POLL_INTERVAL_MS 15000
#define MAX_AIRCRAFT 15
#define TRAIL_LENGTH 15

// CYD display
#define LCD_H_RES 320
#define LCD_V_RES 240

// CYD touch calibration (landscape rotation 1)
// X = horizontal axis (left→right), driven by Y+ electrode (0x90)
// Y = vertical axis (top→bottom), driven by X+ electrode (0xD0)
#define TOUCH_X_MIN 280
#define TOUCH_X_MAX 3950
#define TOUCH_Y_MIN 1100
#define TOUCH_Y_MAX 2600
